PORT=3000
# Origen de datos: "mock" (por defecto) o "supabase"
DATA_SOURCE=mock

# Configuración de Supabase (obligatorio cuando DATA_SOURCE=supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
# Opcional si algún entorno usa anon key en lugar de service role
SUPABASE_ANON_KEY=

WHATSAPP_VERIFY_TOKEN=dev_whatsapp_token

# Webhooks opcionales de n8n para notificaciones por WhatsApp (Workflow D)
N8N_NOTIFY_EVENT_CHANGE_URL=https://hktn.app.n8n.cloud/webhook/pueblos-notify-event-change
N8N_NOTIFY_BUSINESS_URL=https://hktn.app.n8n.cloud/webhook/pueblos-notify-business
