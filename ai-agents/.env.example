# =============================================================================
# VARIABLES DE ENTORNO PARA LOS MICRO-AGENTES IA (ai-agents)
# =============================================================================

# 1. Google Gemini API Key (para gemini-2.5-flash y gemini-2.5-flash-lite)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. NVIDIA NIM API Key (para nemotron-3.5-parse en build.nvidia.com)
NVIDIA_API_KEY=tu_nvidia_api_key_aqui

# 3. Supabase (Opcional, para persistencia de eventos)
SUPABASE_URL=tu_supabase_url_aqui
SUPABASE_KEY=tu_supabase_anon_key_aqui
